# Server
PORT=5000
# HOST=127.0.0.1          # bind to localhost only (use behind Nginx)
# TRUST_PROXY=1           # set to 1 when behind Nginx or another reverse proxy
CLIENT_URL=http://localhost:5173
COOKIE_SECURE=false       # must be true when the site is served over HTTPS

# Database: set DATABASE_URL, or use the DB_* values below
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=portfolio_db
DB_USER=your_db_user
DB_PASSWORD=
DB_SSL=                   # true | no-verify | (empty for local)

# Auth: generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me
